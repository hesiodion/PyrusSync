<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Déclaration de la commande -->
   <extension point="org.eclipse.ui.commands">
      <command
         id="PyrusSync.commands.ping"
         name="Ping Serveur PyrusSync"
         description="Test the connection to the collaboration server"
         defaultHandler="pyrus.sync.commands.PingServerHandler">
      </command>
   </extension>

   <!-- Bouton dans la toolbar principale -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar">
         <toolbar id="PyrusSync.toolbar">
            <command
               commandId="PyrusSync.commands.ping"
               label="Ping Sync"
               tooltip="Testing the connection to the PyrusSync server"
               style="push">
            </command>
         </toolbar>
      </menuContribution>
   </extension>

</plugin>